[Unit]
Description=Xray-Pulse Real-time Traffic Monitor & Bandwidth/Blacklist Console
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xray-pulse
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 127.0.0.1 --port 8443 --log-level warning
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
